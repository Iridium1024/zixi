{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "字隙主窗口：比较、便签管理、导出和数据目录所需能力",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "window-state:default"
  ]
}
